{
	"name": "pipelined",
	"version": "0.106.0",
	"private": true,
	"license": "BSD-3-Clause",
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"test": "pnpm -r test",
		"test:watch": "pnpm -r test:watch",
		"test:types": "pnpm -r test:types",
		"test:coverage": "pnpm -r test:coverage",
		"test:compiler": "pnpm --filter @pplnd/react test:compiler",
		"bench": "pnpm --filter @pplnd/core bench",
		"bench:ci": "pnpm --filter @pplnd/core build && node --expose-gc scripts/bench-gate.ts && node scripts/bench-coverage.ts",
		"typecheck": "tsc --noEmit && pnpm -r typecheck",
		"typecheck:dev": "tsc --noEmit --watch",
		"typecheck:min": "pnpm --filter @pplnd/core typecheck:min",
		"build": "pnpm --filter @pplnd/core --filter @pplnd/react build",
		"size": "pnpm --filter @pplnd/core size",
		"size:update": "node scripts/sync-bundle-sizes.ts",
		"size:check": "pnpm --filter @pplnd/core size:check",
		"toolchain:update": "node scripts/sync-toolchain.ts",
		"lint": "oxlint .",
		"format": "dprint fmt && dprint fmt --config dprint.md.json",
		"format:check": "dprint check && dprint check --config dprint.md.json",
		"docs:dev": "pnpm --filter @pplnd/docs dev",
		"docs:build": "pnpm --filter @pplnd/docs build",
		"check:doc-links": "node scripts/check-doc-links.ts",
		"check:doc-snippets": "node scripts/check-doc-snippets.ts",
		"check:doc-fixtures": "node scripts/check-doc-fixtures.ts",
		"check:docs": "pnpm format:check && pnpm size:check && pnpm check:doc-links && pnpm check:doc-snippets && pnpm check:doc-fixtures && pnpm docs:build",
		"check": "pnpm --filter @pplnd/core build && pnpm lint && pnpm format:check && pnpm test:types && pnpm typecheck && pnpm typecheck:min",
		"check:pr": "pnpm check && pnpm build && pnpm test:coverage && pnpm test:compiler && pnpm check:docs"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"dprint": "0.64.3",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "7.0.2"
	}
}
