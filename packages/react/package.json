{
	"name": "@pplnd/react",
	"version": "0.0.0",
	"description": "React bindings for @pplnd/core: hooks that bind Op managers, machine actors, event buses, and fallible loads to the component lifecycle",
	"homepage": "https://pplnd.dev/",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pplnd/pipelined.git",
		"directory": "packages/react"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"check": "pnpm typecheck"
	},
	"peerDependencies": {
		"@pplnd/core": "workspace:^",
		"react": ">=19.0.0"
	},
	"devDependencies": {
		"@pplnd/core": "workspace:^",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.1.0",
		"jsdom": "27.4.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsdown": "0.23.7",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
