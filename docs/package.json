{
	"name": "@pplnd/docs",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "node scripts/sync-api-docs.mjs --if-missing && astro dev",
		"start": "node scripts/sync-api-docs.mjs --if-missing && astro dev",
		"build": "node scripts/sync-api-docs.mjs && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"typecheck": "node scripts/sync-api-docs.mjs --if-missing && astro sync && tsc --noEmit"
	},
	"dependencies": {
		"@astrojs/mdx": "8.1.6",
		"astro": "7.4.10",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.14.1"
	},
	"devDependencies": {
		"@expo-google-fonts/inter-tight": "0.4.2",
		"@pplnd/core": "workspace:*",
		"@resvg/resvg-js": "2.6.2",
		"typescript": "6.0.3"
	}
}
