---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Route Not Found" description="The requested route resolved to None.">
	<header slot="hero" class="hero guide-hero">
		<div class="hero-brand">
			<a class="wordmark" href="/">pipelined</a>
			<svg class="title-arrow" aria-hidden="true" focusable="false">
				<use class="arrow-right" href="/title-arrow.svg#right" />
				<use class="arrow-down" href="/title-arrow.svg#down" />
			</svg>
		</div>
		<div class="hero-r">
			<h1>404</h1>
			<span class="aside">Result.Err("NOT_FOUND")</span>
		</div>
	</header>

	<article class="article">
		<p class="lead">
			This path resolved to <code>None</code>. The route is unmapped or has moved.
		</p>

		<figure class="result-figure" style="--pplnd-figure-plate: #f6cbb7">
			<svg viewBox="0 0 600 256" role="img" aria-labelledby="not-found-title not-found-desc">
				<title id="not-found-title">Unmatched route circuit diagram branching to recovery</title>
				<desc id="not-found-desc">
					Incoming path terminates at an unmapped Ok(Page) branch beside a vector 404 empty-set marker and branches through a
					recover block toward search and index routes.
				</desc>
				<g fill="none" stroke="currentColor" stroke-width="2">
					<path d="M-8 128 H104 M104 128 L138 52 H234" />
					<path d="M246 52 H356" class="flow-dash" />
					<circle cx="104" cy="128" r="5" fill="currentColor" />
					<circle cx="240" cy="52" r="5" class="flow-node" />

					<path d="M168 82 V126 H224 M206 82 V164" />
					<circle cx="168" cy="82" r="4" fill="currentColor" />
					<circle cx="168" cy="126" r="4" fill="currentColor" />
					<circle cx="206" cy="164" r="4" fill="currentColor" />

					<circle cx="300" cy="124" r="46" class="flow-dash" />
					<circle cx="300" cy="124" r="38" class="flow-node" />
					<path d="M268 156 L282 142 M318 106 L332 92" />

					<path d="M376 82 V126 H432 M414 82 V164" />
					<circle cx="376" cy="82" r="4" fill="currentColor" />
					<circle cx="376" cy="126" r="4" fill="currentColor" />
					<circle cx="414" cy="164" r="4" fill="currentColor" />

					<path d="M104 128 L138 212 H552 M542 202 L552 212 L542 222" />
					<rect x="242" y="190" width="116" height="44" class="flow-node" />
				</g>
				<text id="not-found-path" x="24" y="24" class="flow-tag">/unmapped-route</text>
				<text x="24" y="112" class="flow-tag">route</text>
				<text x="370" y="52" dominant-baseline="central" class="flow-tag">Ok(Page) · unmapped</text>
				<text x="300" y="124" text-anchor="middle" dominant-baseline="central" class="flow-tag">None</text>
				<text x="300" y="212" text-anchor="middle" dominant-baseline="central" class="flow-value">recover</text>
				<text x="372" y="196" class="flow-tag">fallback -> search</text>
			</svg>
			<figcaption>404 · Unmatched route branches to recovery fallback</figcaption>
		</figure>

		<button type="button" class="choosing-cta not-found-search" id="not-found-search-btn">
			<div class="choosing-copy">
				<div class="choosing-tags" aria-hidden="true">
					<span>45 modules</span>
					<span>1,237 API symbols</span>
					<span>Instant filter</span>
				</div>
				<p class="choosing-title" id="not-found-search-title">
					Search the documentation. <span>Find the module or function you were looking for.</span>
				</p>
			</div>
		</button>

		<div class="not-found-grid">
			<a class="not-found-card" href="/">
				<span class="not-found-meta">01 · Overview</span>
				<span class="not-found-title">All 45 modules</span>
			</a>
			<a class="not-found-card" href="/basics/choosing/">
				<span class="not-found-meta">02 · Decision guide</span>
				<span class="not-found-title">Compare types side by side</span>
			</a>
			<a class="not-found-card" href="/api/">
				<span class="not-found-meta">03 · API reference</span>
				<span class="not-found-title">Every signature &amp; export</span>
			</a>
		</div>
	</article>
</BaseLayout>
