---
import { ASYNC_ENGINE_FIGURES } from "../figures/asyncEngines";
import { DATA_AND_TYPE_FIGURES } from "../figures/dataAndTypes";
import { ERRORS_AND_STATE_FIGURES } from "../figures/errorsAndState";
import { REACT_AND_RECIPE_FIGURES } from "../figures/reactAndRecipes";
import type { HeroFigureSpec } from "../figures/types";

export interface Props {
	slug: string;
}

const GUIDE_FIGURES: Record<string, HeroFigureSpec> = {
	...ERRORS_AND_STATE_FIGURES,
	...ASYNC_ENGINE_FIGURES,
	...DATA_AND_TYPE_FIGURES,
	...REACT_AND_RECIPE_FIGURES,
};

const { slug } = Astro.props;
const figure = GUIDE_FIGURES[slug];
---

{figure && (
	<figure class="result-figure" style={`--pplnd-figure-plate: ${figure.plate};`}>
		<svg viewBox="0 0 600 256" role="img" aria-labelledby="flow-title flow-description">
			<title id="flow-title">{figure.title}</title>
			<desc id="flow-description">{figure.desc}</desc>
			<Fragment set:html={figure.svg} />
		</svg>
		<figcaption>{figure.caption}</figcaption>
	</figure>
)}
