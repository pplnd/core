---
import { EXPORT_DOMAINS } from "../data/export-domains";
import styles from "./ExportsTable.module.css";
---

<div class={styles.grid}>
	{EXPORT_DOMAINS.map((domain) => (
		<section class={styles.card}>
			<h3>{domain.title}</h3>
			<p>{domain.description}</p>
			<p>
				<strong>Exports:</strong>{" "}
				{domain.exports.map((name, i) => (
					<>
						<code>{name}</code>
						{i < domain.exports.length - 1 ? " " : ""}
					</>
				))}
			</p>
		</section>
	))}
</div>
