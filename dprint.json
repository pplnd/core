{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"lineWidth": 120,
	"useTabs": true,
	"indentWidth": 1,
	"typescript": {
		"semiColons": "always",
		"quoteStyle": "preferDouble",
		"trailingCommas": "onlyMultiLine",
		"preferSingleLine": true,
		"module.sortImportDeclarations": "caseInsensitive",
		"importDeclaration.sortNamedImports": "caseInsensitive",
		"arrowFunction.useParentheses": "force",
		"ifStatement.useBraces": "always",
		"whileStatement.useBraces": "always",
		"forStatement.useBraces": "always",
		"forInStatement.useBraces": "always",
		"forOfStatement.useBraces": "always"
	},
	"malva": {
		"quotes": "preferDouble"
	},
	"markup": {
		"quotes": "double",
		"scriptIndent": true,
		"styleIndent": true
	},
	"excludes": [
		"dist/",
		".astro/",
		"coverage/",
		"node_modules/",
		"docs/public/",
		"**/*.md",
		"**/*.mdx",
		"**/*.svg"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.96.1.wasm",
		"https://plugins.dprint.dev/json-0.21.3.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.16.1.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.28.0.wasm"
	]
}
